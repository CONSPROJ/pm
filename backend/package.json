{
  "name": "pm-backend",
  "private": true,
  "version": "0.1.0",
  "description": "سرور اختصاصی سامانهٔ پروژه: API، دسترسی‌ها، کنترل مدارک",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "start": "node dist/main.js",
    "dev": "ts-node src/main.ts",
    "migrate": "ts-node src/db/migrate.ts",
    "test": "jest --runInBand"
  },
  "dependencies": {
    "@fastify/helmet": "13.0.1",
    "@fastify/rate-limit": "10.2.1",
    "@nestjs/common": "11.2.8",
    "@nestjs/core": "11.2.8",
    "@nestjs/platform-fastify": "11.2.8",
    "bcryptjs": "2.4.3",
    "pg": "8.13.1",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@nestjs/testing": "11.2.8",
    "@types/bcryptjs": "2.4.6",
    "@types/jest": "29.5.14",
    "@types/node": "22.10.5",
    "@types/pg": "8.11.10",
    "jest": "29.7.0",
    "ts-jest": "29.2.5",
    "ts-node": "10.9.2",
    "typescript": "5.7.3"
  },
  "jest": {
    "preset": "ts-jest",
    "testEnvironment": "node",
    "rootDir": ".",
    "testMatch": [
      "<rootDir>/test/**/*.spec.ts"
    ]
  },
  "overrides": {
    "fastify": "5.12.7"
  }
}
